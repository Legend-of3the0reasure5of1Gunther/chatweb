  "keybindings": {
    "send_message": "Enter",
    "new_line": "Shift+Enter",
    "search_contacts": "Ctrl+K",
    "toggle_sidebar": "Ctrl+B",
    "toggle_dark_mode": "Ctrl+D",
    "screenshot": "Ctrl+Shift+S",
    "file_upload": "Ctrl+U",
    "voice_call": "Ctrl+Shift+V",
    "video_call": "Ctrl+Shift+C",
    "quit": "Ctrl+Q",
    "settings": "Ctrl+,"
  },
  
  "custom_emojis": [
    {
      "name": "party",
      "path": "emojis/party.png",
      "shortcode": ":party:",
      "keywords": ["celebration", "fun", "party"]
    },
    {
      "name": "coffee",
      "path": "emojis/coffee.png",
      "shortcode": ":coffee:",
      "keywords": ["drink", "morning", "break"]
    }
  ],
  
  "server_overrides": {
    "chat.example.com": {
      "tcp_port": 8888,
