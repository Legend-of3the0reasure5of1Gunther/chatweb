# 环境变量
NODE_ENV=development

# 应用配置
VITE_APP_NAME=SecureChat
VITE_APP_VERSION=1.0.0
VITE_APP_TITLE=Secure Chat Application

# API配置
VITE_API_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8081/ws
VITE_API_TIMEOUT=30000

# 安全配置
VITE_SSL_ENABLED=false
VITE_SSL_KEY_PATH=./ssl/localhost-key.pem
VITE_SSL_CERT_PATH=./ssl/localhost-cert.pem
VITE_CORS_ENABLED=true

# 特性开关
VITE_FEATURE_FILE_TRANSFER=true
VITE_FEATURE_GROUP_CHAT=true
VITE_FEATURE_VIDEO_CALL=false
VITE_FEATURE_OFFLINE_MODE=true

# 第三方集成
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
VITE_SENTRY_DSN=your_sentry_dsn
VITE_GOOGLE_ANALYTICS_ID=your_ga_id

# 开发配置
VITE_DEBUG_ENABLED=true
VITE_MOCK_API=false
VITE_LOG_LEVEL=debug

# 性能配置
VITE_CACHE_ENABLED=true
VITE_CACHE_TTL=300000
VITE_COMPRESSION_ENABLED=true
VITE_LAZY_LOAD_ENABLED=true

# PWA配置
VITE_PWA_ENABLED=true
VITE_PWA_NAME=SecureChat
VITE_PWA_SHORT_NAME=SChat
VITE_PWA_THEME_COLOR=#1890ff
VITE_PWA_BACKGROUND_COLOR=#ffffff

# 国际化
VITE_I18N_ENABLED=true
VITE_I18N_FALLBACK_LOCALE=en
VITE_I18N_SUPPORTED_LOCALES=en,zh-CN,ja